# rm-xxx... 是 RDS 实例的「内网地址」(同地域 ECS 走内网，免流量费、低延迟)
MASTER_DB_URL=jdbc:mysql://rm-xxx.mysql.rds.aliyuncs.com:3306/dongjiaoshan?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&autoReconnect=true&rewriteBatchedStatements=true&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DB_USERNAME=djs_app
MASTER_DB_PASSWORD=换成你的强密码

# ========= Redis（宝塔本机）=========
# network_mode: host 模式下，容器 127.0.0.1 直接命中宿主 Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=换成宝塔里给 Redis 设的密码
REDIS_SSL_ENABLED=false

# ========= 伴生服务开关（staging 不装就保持 false）=========
BOOT_ADMIN_ENABLED=false
SNAIL_JOB_ENABLED=false